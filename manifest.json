{
  "schemaVersion": 1,
  "id": "pi.log-viewer",
  "name": "Log Viewer",
  "version": "0.2.0",
  "description": "大日志文件查看器：GB 级流式分页、虚拟滚动、实时跟随、搜索高亮、文本/等级过滤、钉住对比。Log viewer for huge files: paging, tail, search, filter, pin.",
  "author": "Tioit-Wang",
  "categories": ["developer-tools", "productivity"],
  "main": "main.js",
  "ui": {
    "panel": "renderer/index.html",
    "title": "日志查看器",
    "width": 1280,
    "height": 832
  },
  "contributes": {
    "commands": [
      {
        "id": "log-viewer.open",
        "title": "日志查看器：打开",
        "keywords": ["log", "日志", "viewer", "tail", "filter"]
      }
    ]
  },
  "permissions": ["ui.panel", "fs.read", "clipboard.write"],
  "fs": {
    "read": { "root": "userSelected" }
  },
  "engines": {
    "piDesktop": ">=0.14.3"
  },
  "activationEvents": [
    "onCommand:log-viewer.open"
  ]
}
